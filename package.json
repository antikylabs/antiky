{
  "name": "antiky",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "packages/studio/*"
  ],
  "scripts": {
    "antiky": "node --experimental-strip-types --experimental-transform-types packages/cli/src/bin.ts",
    "postinstall": "node scripts/patch-brometal.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:website": "node scripts/dev.mjs website",
    "dev:framework": "node scripts/dev.mjs framework",
    "dev:demos": "node scripts/dev.mjs demos",
    "dev:studio": "npm run dev --workspace @antiky/studio-app",
    "build": "npm run build --workspace @antiky/website",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "shaders": "npm run shaders --workspace @antiky/demos",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "15.5.22",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
