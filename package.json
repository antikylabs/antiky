{
  "name": "antiky",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:website": "node scripts/dev.mjs website",
    "dev:framework": "node scripts/dev.mjs framework",
    "dev:demos": "node scripts/dev.mjs demos",
    "build": "npm run build --workspace @antiky/website",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "shaders": "npm run shaders --workspace @antiky/demos"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
