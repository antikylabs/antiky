{
  "name": "@antiky/framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./game": "./src/game/host.ts",
    "./contract": "./src/game/contract.ts",
    "./render-driver": "./src/render/brometal-driver.ts"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "docs:api:check": "node scripts/generate-api-reference.mjs --check",
    "test": "npm run docs:api:check && node --experimental-strip-types --experimental-transform-types --test tests/**/*.test.ts tests/sessions/engine-session/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "brometal": "0.18.0"
  }
}
