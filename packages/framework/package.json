{
  "name": "@antiky/framework",
  "description": "Game simulation, inspection, and rendering contracts for Antiky projects.",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./game": {
      "types": "./dist/game/host.d.ts",
      "import": "./dist/game/host.js",
      "default": "./dist/game/host.js"
    },
    "./contract": {
      "types": "./dist/game/contract.d.ts",
      "import": "./dist/game/contract.js",
      "default": "./dist/game/contract.js"
    },
    "./render-driver": {
      "types": "./dist/render/brometal-driver.d.ts",
      "import": "./dist/render/brometal-driver.js",
      "default": "./dist/render/brometal-driver.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "docs:api:check": "node scripts/generate-api-reference.mjs --check",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "npm run docs:api:check && node --experimental-strip-types --experimental-transform-types --test tests/**/*.test.ts tests/sessions/engine-session/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antikylabs/antiky.git",
    "directory": "packages/framework"
  },
  "homepage": "https://antikylabs.com/framework",
  "bugs": {
    "url": "https://github.com/antikylabs/antiky/issues"
  },
  "keywords": [
    "game-development",
    "game-engine",
    "typescript",
    "webgpu"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "brometal": "0.18.0"
  }
}
