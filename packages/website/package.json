{
  "name": "@antiky/website",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "predev": "npm run assets:stage && npm run demos:stage",
    "dev": "next dev",
    "prebuild": "npm run docs:api:check --workspace @antiky/framework && npm run assets:stage && npm run demos:stage",
    "build": "next build",
    "demos:stage": "node scripts/build-public-demos.mjs",
    "assets:stage": "node scripts/stage-asset-site.mjs",
    "start": "next start -p 3010",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:release-ready": "NEXT_PUBLIC_STUDIO_RELEASES_READY=true npm run test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antiky/asset-catalog": "0.0.0",
    "@antiky/asset-site": "0.0.0",
    "@antiky/framework": "0.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "marked": "^18.0.9",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
