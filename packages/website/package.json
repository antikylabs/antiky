{
  "name": "@antiky/website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run assets:stage && npm run demos:stage",
    "dev": "next dev",
    "prebuild": "npm run docs:api:check --workspace @antiky/framework && npm run assets:stage && npm run demos:stage",
    "build": "next build",
    "demos:stage": "node scripts/build/public-demos.mjs",
    "assets:stage": "npm run build --workspace @antiky/asset-catalog && node scripts/stage/asset-previews.mjs",
    "media:publish-demo": "node scripts/media/publish-demo-poster.mjs",
    "media:publish-static": "node scripts/media/publish-static-media.mjs",
    "media:validate": "node scripts/media/validate-media-publication.mjs",
    "start": "next start -p 3020",
    "test": "npm run build && node --experimental-strip-types --experimental-transform-types --test tests/*.test.mjs tests/*.test.ts tests/assets/*.test.mjs tests/assets/*.test.ts tests/demo/*.test.mjs",
    "test:release-ready": "NEXT_PUBLIC_STUDIO_RELEASES_READY=true npm run test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antiky/asset-catalog": "0.0.0",
    "@antiky/framework": "0.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "marked": "^18.0.9",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
