{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antiky Studio",
  "version": "0.0.0",
  "identifier": "dev.antiky.studio",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @antiky/studio-app",
    "beforeBuildCommand": "npm run build --workspace @antiky/studio-app",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Antiky Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 680,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../website/public/brand/antiky-labs-wordmark-white.png"
    ]
  }
}
