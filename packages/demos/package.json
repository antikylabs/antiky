{
  "name": "@antiky/demos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./catalog": "./src/catalog.ts",
    "./registry": "./src/registry.ts",
    "./runtime": "./src/runtime.ts",
    "./react": "./src/react/index.ts",
    "./shader-study/shaders/*": "./src/demos/shader-study/shaders/*.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "shaders": "brometal dev --once",
    "shaders:watch": "brometal dev",
    "shaders:prod": "brometal prod",
    "test": "node --experimental-strip-types --experimental-transform-types --test src/demos/brometal-town/physics/character-motor.test.ts src/runtime-inspection.test.ts src/react/development-inspection.test.ts && vitest run src/demos/brometal-town/art/town-validation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antiky/framework": "0.0.0",
    "brometal": "0.14.0"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "4.1.10"
  }
}
